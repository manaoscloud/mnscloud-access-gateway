{
  "nodeModulesDir": "manual",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "check": "deno check --frozen src tests",
    "test": "deno test --cached-only --frozen --allow-net=127.0.0.1 --allow-read --allow-run=deno,openssl tests",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      "node_modules",
      "releases"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ]
}
